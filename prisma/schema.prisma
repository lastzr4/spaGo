generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum ClientGenderPolicy {
  FEMALE_ONLY
  MALE_ONLY
  BOTH
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Therapist {
  id                  String              @id @default(cuid())
  dashboardToken      String              @unique @default(cuid())
  slug                String?             @unique
  name                String
  phone               String
  gender              Gender
  clientGenderPolicy  ClientGenderPolicy  @default(FEMALE_ONLY)
  bio                 String?
  coverageAreas       String[]
  photoUrl            String?
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  services            Service[]
  slots               Slot[]
  bookings            Booking[]
  reviews             Review[]
}

model Service {
  id              String    @id @default(cuid())
  therapistId     String
  therapist       Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal   @db.Decimal(10, 2)
  description     String?
  photoUrl        String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  bookings        Booking[]

  @@index([therapistId])
}

model Slot {
  id          String     @id @default(cuid())
  therapistId String
  therapist   Therapist  @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  startTime   String
  endTime     String
  status      SlotStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())

  booking     Booking?

  @@index([therapistId, date])
  @@unique([therapistId, date, startTime])
}

model Booking {
  id              String        @id @default(cuid())
  therapistId     String
  therapist       Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  slotId          String        @unique
  slot            Slot          @relation(fields: [slotId], references: [id])
  customerName    String
  customerPhone   String
  customerAddress String
  customerGender  Gender
  outcallFee      Decimal       @default(0) @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  review          Review?

  @@index([therapistId])
}

model Review {
  id            String    @id @default(cuid())
  therapistId   String
  therapist     Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  customerName  String
  rating        Int
  comment       String?
  hidden        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([therapistId])
}

model SiteSettings {
  id              String   @id @default("singleton")
  themeColor      String   @default("#7a51c9")
  backgroundColor String   @default("#faf9fc")
  updatedAt       DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum ClientGenderPolicy {
  FEMALE_ONLY
  MALE_ONLY
  BOTH
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  QR
  CASH
  TOYYIBPAY
}

model Therapist {
  id                  String              @id @default(cuid())
  dashboardToken      String              @unique @default(cuid())
  slug                String?             @unique
  username            String?             @unique
  pinHash             String?
  name                String
  phone               String
  gender              Gender
  clientGenderPolicy  ClientGenderPolicy  @default(FEMALE_ONLY)
  bio                 String?
  coverageAreas       String[]
  photoUrl            String?
  active              Boolean             @default(true)
  isDemo              Boolean             @default(false)
  depositRequired     Boolean             @default(false)
  depositAmount       Decimal?            @db.Decimal(10, 2)
  paymentMethod       PaymentMethod?
  qrCodeUrl           String?
  extraChargesNote    String?
  socialInstagram     String?
  socialTiktok        String?
  socialThreads       String?
  socialX             String?
  specialties         String[]            @default([])
  yearsExperience     Int?
  workingHoursNote    String?
  galleryPhotos       String[]            @default([])
  baseLat             Float?
  baseLng             Float?
  cancellationWindowHours Int             @default(2)
  travelFeeEnabled    Boolean             @default(false)
  travelFreeRadiusKm  Float               @default(5)
  travelRatePerKm     Float               @default(1)
  aiChatEnabled       Boolean             @default(true)
  reviewSummary       String?
  reviewSummaryUpdatedAt DateTime?
  weeklyTemplate      Json?
  templateGeneratedUntil DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  services            Service[]
  slots               Slot[]
  bookings            Booking[]
  reviews             Review[]
  customerNotes       CustomerNote[]
  chatUsage           ChatUsage[]
  pushSubscriptions   PushSubscription[]
}

// One row per browser/device the therapist enabled notifications on (a
// therapist using two phones gets two rows). Endpoint is the unique push
// URL the browser's push service issued — used both as the send target and
// as the natural de-dupe key if they subscribe again from the same device.
model PushSubscription {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())

  @@index([therapistId])
}

model Service {
  id              String    @id @default(cuid())
  therapistId     String
  therapist       Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal   @db.Decimal(10, 2)
  promoPrice      Decimal?  @db.Decimal(10, 2)
  badge           String?
  description     String?
  photoUrl        String?
  active          Boolean   @default(true)
  isPackage       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  bookings        Booking[]

  // Self many-to-many, directional: packageItems = "the plain services this
  // package bundles together" (only meaningful when isPackage is true).
  // includedInPackages is the reverse lookup, kept mainly so Prisma can
  // model the relation — not used for querying today. A service can be
  // listed inside a package, or be a package, but never both at once
  // (nested packages are rejected at the API layer, not the schema layer).
  packageItems        Service[] @relation("PackageItems")
  includedInPackages  Service[] @relation("PackageItems")

  @@index([therapistId])
}

model Slot {
  id          String     @id @default(cuid())
  therapistId String
  therapist   Therapist  @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  startTime   String
  endTime     String
  status      SlotStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())

  // Not 1:1 — a slot can accumulate multiple Booking rows over its
  // lifetime (e.g. one cancelled, then rebooked later), so Booking.slotId
  // is intentionally NOT @unique. Slot.status is the sole source of truth
  // for "is this slot bookable right now"; callers that want the booking
  // currently occupying the slot should filter out CANCELLED rows and take
  // the most recent one (see app/dashboard/[token]/slots/page.tsx).
  bookings    Booking[]

  // A service longer than one generic hourly slot claims extra consecutive
  // slots to block them for other customers. The FIRST slot stays the
  // booking's real relation above (via Booking.slotId); any EXTRA slots
  // point back here instead — kept as a separate field since a slot's main
  // `bookings` relation is keyed off its own id, not the overflow booking's.
  overflowForBookingId String?
  overflowForBooking   Booking?   @relation("SlotOverflow", fields: [overflowForBookingId], references: [id], onDelete: SetNull)

  @@index([therapistId, date])
  @@unique([therapistId, date, startTime])
}

model Booking {
  id                String        @id @default(cuid())
  therapistId       String
  therapist         Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service       @relation(fields: [serviceId], references: [id])
  slotId            String
  slot              Slot          @relation(fields: [slotId], references: [id])
  customerName      String
  customerPhone     String
  customerAddress   String
  customerLat       Float?
  customerLng       Float?
  customerGender    Gender
  outcallFee        Decimal       @default(0) @db.Decimal(10, 2)
  travelDistanceKm  Float?
  status            BookingStatus @default(PENDING)
  referralCodeUsed  String?
  healthConsentAccepted   Boolean   @default(false)
  healthConsentAcceptedAt DateTime?
  healthConsentText       String?
  depositAmountSnapshot   Decimal?  @db.Decimal(10, 2)
  depositForfeited        Boolean   @default(false)
  lateCancellation        Boolean   @default(false)
  cancelledAt             DateTime?
  depositReceiptUrl        String?
  depositReceiptUploadedAt DateTime?
  depositReceiptAiVerdict  String?
  depositReceiptAiNotes    String?
  // ToyyibPay online deposit (alternative to the manual QR+receipt flow
  // above) — set when the therapist's paymentMethod is TOYYIBPAY. Status is
  // a plain string ("PENDING" | "PAID" | "FAILED") rather than an enum
  // since it mirrors toyyibPay's own callback status codes 1:1, no need for
  // a stricter type here.
  toyyibpayBillCode        String?
  toyyibpayPaymentStatus   String?
  toyyibpayPaidAt          DateTime?
  createdAt         DateTime      @default(now())
  review            Review?

  // Extra hourly slots blocked because the service's duration didn't fit in
  // one generic slot — see Slot.overflowForBookingId above.
  overflowSlots     Slot[]        @relation("SlotOverflow")

  @@index([therapistId])
  @@index([therapistId, customerPhone])
  @@index([slotId])
}

model CustomerNote {
  id            String    @id @default(cuid())
  therapistId   String
  therapist     Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  customerPhone String
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([therapistId, customerPhone])
  @@index([therapistId])
}

model ChatUsage {
  id           String   @id @default(cuid())
  therapistId  String
  therapist    Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date         String
  messageCount Int      @default(0)

  @@unique([therapistId, date])
  @@index([therapistId])
}

model Review {
  id            String    @id @default(cuid())
  therapistId   String
  therapist     Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  customerName  String
  rating        Int
  comment       String?
  hidden        Boolean   @default(false)
  aiFlagged     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([therapistId])
}

model SiteSettings {
  id                  String   @id @default("singleton")
  themeColor          String   @default("#7a51c9")
  backgroundColor     String   @default("#faf9fc")
  heroTitle           String   @default("Urut rumah, ditempah terus.")
  heroSubtitle        String   @default("Cari terapis mobile berhampiran anda dan tempah terus ke WhatsApp — tanpa PM, tanpa tunggu.")
  heroBackgroundImage String?
  adminEmail          String?
  // Cached once via toyyibPay's createCategory API on first use (all bills
  // across every therapist share this one category — it's just a grouping
  // label in toyyibPay's dashboard, not a per-therapist concept, since
  // there is a single toyyibPay account for the whole platform).
  toyyibpayCategoryCode String?
  updatedAt           DateTime @updatedAt
}
